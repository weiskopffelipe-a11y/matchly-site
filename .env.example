# ---------- Na Vercel (Settings → Environment Variables) ----------
# Públicas (o navegador vê): endereço do banco e a chave "publishable"
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Opcional: logos automáticas das empresas pelo site delas (logo.dev, plano grátis)
VITE_LOGO_DEV_TOKEN=pk_...
# Secretas (só o servidor vê): usadas pela /api/empresas
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...
# Opcional: e-mail de confirmação no cadastro de empresa (resend.com)
RESEND_API_KEY=
EMAIL_REMETENTE=Matchly <contato@seudominio.com.br>
EMAIL_ADMIN=

# ---------- No GitHub (Settings → Secrets and variables → Actions) ----------
# SUPABASE_URL e SUPABASE_SERVICE_KEY (os mesmos de cima)
# ANTHROPIC_API_KEY  → liga a IA que classifica vagas e lê páginas sem formato padrão (opcional)
# ADZUNA_APP_ID / ADZUNA_APP_KEY → vagas da Adzuna (opcional, grátis em developer.adzuna.com)
# JOOBLE_API_KEY     → vagas da Jooble (opcional, grátis em jooble.org/api/about)
